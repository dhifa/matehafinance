# Frontend settings (Vite). Copy to .env.local if you need to change them.

# Where `npm run dev` forwards /api requests (the CodeIgniter 4 backend).
BACKEND_URL="http://localhost:8080"

# Only set this when the API is hosted on a different domain than the app.
# VITE_API_BASE_URL="https://api.example.com"

# Gemini (AI scan) is now configured in backend/.env as GEMINI_API_KEY.
